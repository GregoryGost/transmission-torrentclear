{
  "name": "@gregory-gost/transmission-torrentclear",
  "version": "3.2.0",
  "description": "Torrent clear script for transmission-daemon service",
  "license": "GPL-3",
  "keywords": [
    "gregory-gost",
    "transmission",
    "transmission-torrentclear",
    "transmission-daemon",
    "torrentclear",
    "torrent-clear-script",
    "typescript",
    "proxmox",
    "lxc"
  ],
  "author": {
    "name": "Grigoriy Schetintsev (GregoryGost)",
    "email": "info@gregory-gost.ru"
  },
  "scripts": {
    "bundle": "pnpm run format:write && pnpm run package",
    "ci-test": "pnpm jest",
    "coverage": "pnpm make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "lint": "pnpm eslint -c eslint.config.mjs .",
    "lint:debug": "pnpm eslint --debug -c eslint.config.mjs .",
    "package": "pnpm tsup",
    "all": "pnpm run format:write && pnpm run lint && pnpm run ci-test && pnpm run coverage && pnpm run package",
    "check-lib": "pnpm outdated"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@jest/globals": "30.2.0",
    "@tsconfig/node20": "20.1.8",
    "@eslint/js": "9.39.2",
    "@types/jest": "30.0.0",
    "@types/nconf": "0.10.7",
    "@types/node": "25.0.3",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "eslint": "9.39.2",
    "eslint-plugin-github": "6.0.0",
    "eslint-plugin-jest": "29.12.0",
    "eslint-plugin-jsonc": "2.21.0",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.5.0",
    "jest": "30.2.0",
    "log4js": "6.9.1",
    "make-coverage-badge": "1.2.0",
    "moment": "2.30.1",
    "nconf": "0.13.0",
    "prettier": "3.7.4",
    "prettier-eslint": "16.4.2",
    "ts-jest": "29.4.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.51.0"
  }
}
